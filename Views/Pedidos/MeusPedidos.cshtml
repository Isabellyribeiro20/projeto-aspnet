@model IEnumerable<Patudinhos.Models.Pedido>
@{
    ViewData["Title"] = "Meus Pedidos";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Meus Pedidos", null)
    };
}

<div class="cartao">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; padding-bottom:14px; border-bottom:1px solid #e0ddd5;">
        <h1 style="font-size:20px; font-weight:600; color:#1a1a18; margin:0;">Meus Pedidos</h1>
        <a asp-controller="Home" asp-action="Index" class="btn-secundario">← Continuar comprando</a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:60px; color:#9b9890;">
            <div style="font-size:48px; margin-bottom:12px;">📦</div>
            <p style="margin-bottom:16px;">Você ainda não realizou nenhum pedido.</p>
            <a asp-controller="Home" asp-action="Index" class="btn-primario">Ver produtos</a>
        </div>
    }
    else
    {
        @foreach (var pedido in Model)
        {
            <div style="border:1px solid #e0ddd5; border-radius:12px; margin-bottom:14px; overflow:hidden;">

                <!-- Cabeçalho -->
                <div style="background:#f0ede6; padding:12px 18px; display:flex; align-items:center; justify-content:space-between;">
                    <div>
                        <div style="font-size:13px; font-weight:500; color:#1a1a18;">Pedido #@pedido.Id</div>
                        <div style="font-size:12px; color:#9b9890; margin-top:2px;">@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <span class="@(pedido.Status switch {
                        Patudinhos.Models.StatusPedido.Entregue   => "badge-verde",
                        Patudinhos.Models.StatusPedido.EmTransito => "badge-azul",
                        Patudinhos.Models.StatusPedido.Cancelado  => "badge-cinza",
                        _                                         => "badge-amarelo"
                    })">
                        @(pedido.Status switch {
                            Patudinhos.Models.StatusPedido.Entregue   => "Entregue",
                            Patudinhos.Models.StatusPedido.EmTransito => "Em trânsito",
                            Patudinhos.Models.StatusPedido.Cancelado  => "Cancelado",
                            _                                         => "Processando"
                        })
                    </span>
                </div>

                <!-- Itens -->
                <div style="padding:14px 18px;">
                    @if (pedido.Itens != null && pedido.Itens.Any())
                    {
                        @foreach (var item in pedido.Itens)
                        {
                            <div style="display:flex; align-items:center; gap:12px; padding:8px 0; border-bottom:1px solid #f0ede6;">
                                <div style="width:40px; height:40px; border-radius:8px; background:#EAF3DE; flex-shrink:0; overflow:hidden; display:flex; align-items:center; justify-content:center;">
                                    @if (!string.IsNullOrEmpty(item.Produto?.FotoUrl))
                                    {
                                        <img src="@item.Produto.FotoUrl" style="width:100%; height:100%; object-fit:cover;" />
                                    }
                                </div>
                                <div style="flex:1;">
                                    <div style="font-size:13px; font-weight:500; color:#1a1a18;">@item.Produto?.Nome</div>
                                    <div style="font-size:12px; color:#9b9890;">Qtd: @item.Quantidade · R$ @item.PrecoUnitario.ToString("N2") / un.</div>
                                </div>
                                <div style="font-size:13px; font-weight:500; color:#0F6E56;">
                                    R$ @item.Subtotal.ToString("N2")
                                </div>
                            </div>
                        }
                    }

                    <!-- Rodapé -->
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:12px;">
                        <div>
                            <div style="font-size:12px; color:#9b9890;">Total</div>
                            <div style="font-size:16px; font-weight:600; color:#1a1a18;">R$ @pedido.Total.ToString("N2")</div>
                        </div>
                        <a asp-action="Details" asp-route-id="@pedido.Id" class="btn-secundario">Ver detalhes</a>
                    </div>
                </div>
            </div>
        }
    }
</div>
